<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target .NET 8 with Windows-specific features -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>NWRS_AC_SDPlugin</RootNamespace>
    <AssemblyName>nwrs-ac-sd-plugin</AssemblyName>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    
    <!-- Output path configuration (preserves your existing structure) -->
    <OutputPath Condition="'$(Configuration)' == 'Debug'">bin\Debug\com.nwracingsims.acuic.sdPlugin\</OutputPath>
    <OutputPath Condition="'$(Configuration)' == 'Release'">bin\Release\com.nwracingsims.acuic.sdPlugin\</OutputPath>
    
    <!-- Self-contained single-file deployment (NO external dependencies) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    
    <!-- Trimming configuration to reduce size -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- NuGet Package References -->
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="streamdeck-client-csharp" Version="4.3.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.5" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="System.Text.Json" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Markdown documentation files -->
    <None Update="INHERITANCE_EXAMPLES.md">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="PROTOCOL.md">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    
    <!-- StreamDeck manifest (must be in output directory) -->
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Image assets (copy to output and publish directories) -->
    <Content Include="Images\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="NWRS AC SD Plugin\**" />
    <EmbeddedResource Remove="NWRS AC SD Plugin\**" />
    <None Remove="NWRS AC SD Plugin\**" />
  </ItemGroup>

</Project>
